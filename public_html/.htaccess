RewriteEngine On

# Force HTTPS and drop www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old URLs -> new single-page site (preserve link equity)
RewriteRule ^liners-aquaveil\.html$ / [R=301,L]
RewriteRule ^about-aquaveil\.html$ / [R=301,L]
RewriteRule ^contact-aquaveil\.html$ /contact [R=301,L]
RewriteRule ^shop/?$ / [R=301,L]
RewriteRule ^about/?$ / [R=301,L]

DirectoryIndex index.html

# SPA fallback -- client-side routes (e.g. /contact) resolve to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# HTML always revalidates so updates show immediately
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Cache fingerprinted static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
